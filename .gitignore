# data (regenerated by `pythia fetch`)
data/raw/*.csv
data/raw/*.parquet
data/raw/*.json
data/processed/*.parquet
.soccerdata/

# FPL snapshots ARE committed: they accumulate into the only historical
# availability series this project has.
!data/fpl/*.parquet

# pytest temp trees (Windows sometimes puts them next to the workspace)
pytest-of-*/
pytest-*/

# python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
build/
dist/

# os / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# matplotlib cache created when running locally
.matplotlib/

# local outputs that are not part of the published report
reports/_local/
